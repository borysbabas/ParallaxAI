{
  "name": "frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc -b && vite build",
    "build-production": "vite build --mode=production",
    "build-development": "vite build --mode=development",
    "preview": "vite preview",
    "cap:sync": "npm run build && npx cap sync",
    "cap:sync:dev": "npm run build-development && npx cap sync",
    "cap:open:android": "npx cap open android",
    "cap:open:ios": "npx cap open ios",
    "cap:run:android": "npm run cap:sync && npx cap run android",
    "cap:run:android:live": "npx cap run android --live-reload --host=0.0.0.0",
    "cap:run:ios": "npm run cap:sync && npx cap run ios",
    "cap:run:ios:live": "npx cap run ios --live-reload --host=0.0.0.0",
    "android:deploy": "powershell -ExecutionPolicy Bypass -File ./deploy-android.ps1"
  },
  "dependencies": {
    "@capacitor/android": "^8.0.0",
    "@capacitor/camera": "^8.0.0",
    "@capacitor/cli": "^8.0.0",
    "@capacitor/core": "^8.0.0",
    "@capacitor/ios": "^8.0.0",
    "@capacitor/splash-screen": "^8.0.0",
    "@capacitor/status-bar": "^8.0.0",
    "@heroicons/vue": "^2.2.0",
    "@tailwindcss/vite": "^4.1.14",
    "chart.js": "^4.5.1",
    "dotenv": "^17.2.3",
    "qrcode.vue": "^3.6.0",
    "tailwindcss": "^4.1.14",
    "vue": "^3.5.22",
    "vue-router": "^4.5.1"
  },
  "devDependencies": {
    "@types/node": "^24.6.0",
    "@vitejs/plugin-vue": "^6.0.1",
    "@vue/tsconfig": "^0.8.1",
    "typescript": "~5.9.3",
    "vite": "7.1.11",
    "vue-tsc": "^3.1.1"
  }
}
